generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GRADUATE
  ADVISOR
  INSTITUTION_ADMIN
  SUPER_ADMIN
}

enum ApplicationStatus {
  PENDING
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

enum SkillGap {
  LOW
  MEDIUM
  HIGH
}

enum SkillImpact {
  LOW
  MEDIUM
  HIGH
}

enum CredentialStatus {
  PENDING
  VERIFIED
  EXPIRED
}

enum MarketTrend {
  UP
  DOWN
  STABLE
  HOT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(GRADUATE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile      Profile?
  applications Application[]
  skills       UserSkill[]
  credentials  UserCredential[]
  coachSessions CoachSession[]
  savedJobs    SavedJob[]
  chatMessages  ChatMessage[]

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  cvs           UserCV[]
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String?
  university   String?
  faculty      String?
  degreeLevel  String?  // Bachelor, Master, PhD
  studyMode    String?  // Full-time, Part-time
  graduationYear Int?
  targetRole   String?
  targetSector String?
  gpa          Float?
  location     String?
  bio          String?
  avatarUrl    String?
  updatedAt    DateTime @updatedAt
}

model Job {
  id              String   @id @default(cuid())
  title           String
  company         String
  district        String
  salaryMin       Int
  salaryMax       Int
  responsibilities String
  requirements    String
  skills          String[] // array of skill names
  sector          String?
  deadline        DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications    Application[]
  savedBy         SavedJob[]
}

model SavedJob {
  userId    String
  jobId     String
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  jobId         String
  status        ApplicationStatus @default(PENDING)
  stage         String            @default("Application Submitted")
  appliedDate   DateTime          @default(now())
  interviewDate DateTime?
  notes         String?
  updatedAt     DateTime          @updatedAt

  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job  @relation(fields: [jobId], references: [id])
}

model Skill {
  id          String      @id @default(cuid())
  name        String      @unique
  category    String?
  description String?

  userSkills  UserSkill[]
}

model UserSkill {
  id          String      @id @default(cuid())
  userId      String
  skillId     String
  level       Int         @default(0) // 0-100
  gap         SkillGap    @default(HIGH)
  impact      SkillImpact @default(MEDIUM)
  updatedAt   DateTime    @updatedAt

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
}

model UserCredential {
  id         String           @id @default(cuid())
  userId     String
  category   String           // "Degree & Transcript", "HEAR", "Certificates"
  name       String
  issuer     String
  status     CredentialStatus @default(PENDING)
  issuedDate DateTime?
  fileUrl    String?
  createdAt  DateTime         @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoachSession {
  id         String   @id @default(cuid())
  userId     String
  type       String   // "interview_practice", "resume_review", "career_advice"
  topic      String?
  summary    String?
  score      Int?     // 0-100
  feedback   Json?
  durationMs Int?
  createdAt  DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Institution {
  id              String   @id @default(cuid())
  name            String   @unique
  domain          String?  // e.g. cuhk.edu.hk
  logoUrl         String?
  createdAt       DateTime @default(now())

  users                 User[]
  programmes            Programme[]
  graduateOutcomes      GraduateOutcome[]
  issuedCredentials     IssuedCredential[]
  employerRelationships EmployerRelationship[]
  snapshots             InstitutionSnapshot[]
  insights              InstitutionInsight[]
  careerStages          AlumniCareerStage[]
  salaryStages          AlumniSalaryStage[]
  engagements           AlumniEngagement[]
  sectorTrends          MarketSectorTrend[]
  districtSalaries      DistrictSalaryBenchmark[]
  skillShortages        SkillShortage[]
  competencyFeedbacks   CompetencyFeedback[]
  demandForecasts       DemandForecast[]
  pipeline              PartnershipPipeline[]
  satisfactionTrends    EmployerSatisfactionTrend[]
  employerEvents        EmployerEvent[]
  partnerActivities     PartnershipActivity[]
  alumniEvents          AlumniEvent[]
}

model Programme {
  id            String   @id @default(cuid())
  institutionId String
  name          String
  faculty       String
  degreeLevel   String
  employmentRate Float   @default(0)
  avgSalary     Float   @default(0)
  timeToOffer   Float   @default(0) // months
  satisfaction  Float   @default(0) // 0-5
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id])
  outcomes      GraduateOutcome[]
  snapshots     ProgrammeSnapshot[]
}

model GraduateOutcome {
  id              String   @id @default(cuid())
  institutionId   String
  programmeId     String?
  cohortRef       String   // anonymised "A001" etc.
  cohortYear      Int
  sector          String?
  role            String?
  company         String?
  salaryBand      String?
  timeToOfferDays Int?
  geography       String?
  createdAt       DateTime @default(now())

  institution     Institution @relation(fields: [institutionId], references: [id])
  programme       Programme?  @relation(fields: [programmeId], references: [id])
}

model IssuedCredential {
  id            String           @id @default(cuid())
  institutionId String
  recipientRef  String           // anonymised graduate ref
  type          String           // "HEAR", "Degree", "Certificate"
  name          String
  status        CredentialStatus @default(PENDING)
  issuedAt      DateTime?
  createdAt     DateTime         @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id])
}

model Employer {
  id          String   @id @default(cuid())
  name        String   @unique
  sector      String?
  district    String?
  logoUrl     String?
  website     String?
  createdAt   DateTime @default(now())

  relationships EmployerRelationship[]
  programmes    GraduateProgramme[]
}

model EmployerRelationship {
  id            String   @id @default(cuid())
  institutionId String
  employerId    String
  tier          String   // "Platinum", "Gold", "Silver"
  jobPostings   Int      @default(0)
  internships   Int      @default(0)
  placements    Int      @default(0)
  updatedAt     DateTime @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id])
  employer      Employer    @relation(fields: [employerId], references: [id])

  @@unique([institutionId, employerId])
}

model GraduateProgramme {
  id           String   @id @default(cuid())
  employerId   String
  name         String
  logo         String?
  deadline     DateTime?
  salaryMin    Int?
  salaryMax    Int?
  successRate  Float    @default(0)
  sector       String?
  location     String?
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  employer     Employer @relation(fields: [employerId], references: [id])
}

model MarketSignal {
  id          String      @id @default(cuid())
  title       String
  description String?
  trend       MarketTrend @default(STABLE)
  salaryMin   Int?
  salaryMax   Int?
  sector      String?
  district    String?
  role        String?
  source      String?
  publishedAt DateTime    @default(now())
  expiresAt   DateTime?
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}

model UserCV {
  id        String   @id @default(cuid())
  userId    String
  filename  String
  rawText   String
  fileUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  edits     CVEdit[]
}

model CVEdit {
  id          String   @id @default(cuid())
  cvId        String
  section     String
  original    String
  suggestion  String
  reason      String?
  applied     Boolean  @default(false)
  createdAt   DateTime @default(now())

  cv          UserCV   @relation(fields: [cvId], references: [id], onDelete: Cascade)
}

model AlumniPath {
  id                String   @id @default(cuid())
  name              String
  typicalRoles      String[]
  timeToTransition  String
  description       String?
  sector            String?
  createdAt         DateTime @default(now())
}

model InstitutionSnapshot {
  id                String   @id @default(cuid())
  institutionId     String
  year              Int
  employmentRate    Float
  medianSalary      Float
  timeToOfferDays   Float
  employedCount     Int      @default(0)
  furtherStudyCount Int      @default(0)
  seekingCount      Int      @default(0)
  otherCount        Int      @default(0)
  createdAt         DateTime @default(now())

  institution       Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, year])
}

model ProgrammeSnapshot {
  id             String   @id @default(cuid())
  programmeId    String
  year           Int
  employmentRate Float
  medianSalary   Float
  createdAt      DateTime @default(now())

  programme      Programme @relation(fields: [programmeId], references: [id])

  @@unique([programmeId, year])
}

model InstitutionInsight {
  id            String   @id @default(cuid())
  institutionId String
  type          String   // "success", "alert", "info", "warning"
  title         String
  description   String
  createdAt     DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id])
}

model AlumniCareerStage {
  id            String   @id @default(cuid())
  institutionId String
  yearsRange    String
  sector        String
  count         Int      @default(0)
  createdAt     DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, yearsRange, sector])
}

model AlumniSalaryStage {
  id            String   @id @default(cuid())
  institutionId String
  yearsRange    String
  medianSalary  Float
  q1Salary      Float
  q3Salary      Float
  createdAt     DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, yearsRange])
}

model AlumniEngagement {
  id                    String   @id @default(cuid())
  institutionId         String
  year                  Int
  month                 String
  mentorshipConnections Int      @default(0)
  eventsAttended        Int      @default(0)
  jobPostings           Int      @default(0)
  createdAt             DateTime @default(now())

  institution           Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, year, month])
}

model MarketSectorTrend {
  id            String   @id @default(cuid())
  institutionId String
  quarter       String
  sector        String
  demandIndex   Int
  createdAt     DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, quarter, sector])
}

model DistrictSalaryBenchmark {
  id            String   @id @default(cuid())
  institutionId String
  district      String
  median        Int
  q1Salary      Int
  q3Salary      Int
  jobCount      Int      @default(0)
  year          Int
  createdAt     DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, district, year])
}

model SkillShortage {
  id            String   @id @default(cuid())
  institutionId String
  skill         String
  shortage      Int
  demandGrowth  Int
  salaryPremium Int
  supply        Int      @default(0)
  createdAt     DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, skill])
}

model CompetencyFeedback {
  id            String   @id @default(cuid())
  institutionId String
  competency    String
  current       Int
  desired       Int
  year          Int
  createdAt     DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, competency, year])
}

model DemandForecast {
  id            String   @id @default(cuid())
  institutionId String
  month         String
  monthOrder    Int
  year          Int
  actual        Int?
  forecast      Int
  historical    Int
  createdAt     DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, year, month])
}

model PartnershipPipeline {
  id             String   @id @default(cuid())
  institutionId  String
  stage          String
  count          Int
  conversionRate Int
  sortOrder      Int      @default(0)
  updatedAt      DateTime @updatedAt

  institution    Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, stage])
}

model EmployerSatisfactionTrend {
  id            String   @id @default(cuid())
  institutionId String
  quarter       String
  quarterOrder  Int      @default(0)
  overall       Float
  graduates     Float
  support       Float
  processes     Float
  createdAt     DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, quarter])
}

model EmployerEvent {
  id            String   @id @default(cuid())
  institutionId String
  month         String
  monthOrder    Int
  year          Int
  careerFairs   Int      @default(0)
  workshops     Int      @default(0)
  networking    Int      @default(0)
  attendance    Int      @default(0)
  createdAt     DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, year, month])
}

model PartnershipActivity {
  id            String   @id @default(cuid())
  institutionId String
  type          String
  employer      String
  action        String
  createdAt     DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id])
}

model AlumniEvent {
  id              String   @id @default(cuid())
  institutionId   String
  title           String
  date            DateTime
  time            String
  host            String
  mode            String
  relevantPathIds String[]
  createdAt       DateTime @default(now())

  institution     Institution @relation(fields: [institutionId], references: [id])
}
